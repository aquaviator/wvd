import '../styles/showcase.css';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Services | Wear Valley Digital" description="Websites, bespoke software and automation delivered by Wear Valley Digital." canonical="https://wearvalleydigital.com/services/">
<section class="showcase-hero"><div class="wrap"><p class="eyebrow">Digital services / Founder-led delivery</p><h1>Build around your business</h1><p class="lede">Start with what your customers and colleagues need. We shape the scope together, then build and test the agreed solution.</p><div class="button-row"><a class="button" href="/enquire/">Discuss your project ↗</a><a class="text-link" href="#websites">Explore the services ↓</a></div></div></section>
<section class="section"><div class="wrap grid"><article class="card" id="websites"><p class="eyebrow">01 / Your digital presence</p><h2>Websites</h2><p>Clear content, useful customer journeys and a site that works on phones as well as larger screens.</p><a class="text-link" href="/products/">Explore our products →</a></article><article class="card" id="software"><p class="eyebrow">02 / Your specialist workflow</p><h2>Software</h2><p>Applications for a specific problem, from organising information to supporting a team workflow.</p><a class="text-link" href="/work/">See product engineering →</a></article><article class="card" id="automation"><p class="eyebrow">03 / Your time, better spent</p><h2>Automation</h2><p>Reduce repeated manual tasks and connect systems with defined access, checks and useful results.</p><a class="text-link" href="/enquire/">Discuss an automation →</a></article></div></section>
<section class="section"><div class="wrap showcase-callout"><div><h2>See the thinking in practice</h2><p>Human V1, PECP, Salon and Wedding show the range of products we’re building. Hospitality is coming next.</p></div><a class="button" href="/products/">Explore the portfolio</a></div></section>
<section class="section"><div class="wrap prose"><h2>Care after launch</h2><p>Care covers maintenance, security updates, monitoring, appropriate backup and recovery, and fault investigation. It is required with WVD-managed hosting and optional with customer-managed hosting.</p><p>New features, redesigns and routine content changes are scoped separately. The hosting arrangement, support terms and handover are agreed as part of your quote.</p><p><a class="text-link" href="/insights/care-and-development/">Read the Care and development guide →</a></p><h2>Discuss your project</h2><p>Local in-person and UK remote delivery. Tell us your business, the problem you want to solve and any timing constraints.</p><div class="button-row"><a class="button" href="/enquire/">Prepare a project enquiry</a><a class="text-link" href="mailto:hello@wearvalleydigital.com">Email a general enquiry</a></div></div></section>
</BaseLayout>
