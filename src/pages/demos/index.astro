---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/demos.css';
---
<BaseLayout title="Explore our demos | Wear Valley Digital" description="Try fictional hospitality and salon website demonstrations with clearly simulated interactions." canonical={new URL('/demos/', Astro.site)} disableAnalytics={true}>
  <div class="wrap"><section class="demo-hero"><a class="text-link" href="/services/">← Back to services</a><p class="eyebrow">Explore the experience</p><h1>Try a working example.</h1><p class="lede">See how a clear website can help customers understand your business and take the next step.</p><p class="status">These businesses are fictional. Every interaction is simulated; no enquiry, booking or payment is made.</p></section><section class="section grid" aria-label="Available demonstrations"><article class="panel"><h2>Hospitality</h2><p>The Fellside Kitchen brings together a sample menu, opening hours and a dining enquiry that awaits a venue response.</p><a class="button" href="/demos/hospitality/">Explore hospitality demo</a></article><article class="panel"><h2>Salon</h2><p>Juniper Studio shows treatment durations and sample appointment slots for one practitioner, with payment at the salon.</p><a class="button" href="/demos/salon/">Explore salon demo</a></article></section></div>
</BaseLayout>
