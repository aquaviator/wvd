---
import BaseLayout from '../layouts/BaseLayout.astro'; import { loadCategories, loadProducts } from '../lib/validation/load'; const products=loadProducts().filter(x=>x.product.featured); const categories=loadCategories();
---
<BaseLayout title="Wear Valley Digital | Practical digital tools" description="Practical digital tools for real-world problems." canonical="https://wearvalleydigital.com/"><section class="hero"><div class="wrap"><p class="eyebrow">Wear Valley Digital</p><h1>Practical digital tools for real-world problems</h1><p class="lede">Focused templates, spreadsheets and guides designed to make everyday work clearer.</p><a class="button" href="/products/">Explore products</a></div></section><section class="section"><div class="wrap"><h2>Featured products</h2><div class="grid">{products.map(x=><article class="card"><p class="eyebrow">{x.product.category}</p><h3><a href={`/products/${x.product.category}/${x.product.slug}/`}>{x.product.name}</a></h3><p>{x.product.copy.short_description}</p></article>)}</div></div></section><section class="section"><div class="wrap"><h2>Browse by category</h2><div class="grid">{categories.map(x=><article class="card"><h3><a href={`/products/${x.slug}/`}>{x.name}</a></h3><p>{x.description}</p></article>)}</div></div></section></BaseLayout>
