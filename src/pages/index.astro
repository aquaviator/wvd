---
import BaseLayout from '../layouts/BaseLayout.astro'; import { loadCategories, loadProducts } from '../lib/validation/load'; const products=loadProducts().filter(x=>x.product.featured); const categories=loadCategories();
---
<BaseLayout title="Wear Valley Digital | Practical digital tools" description="Practical digital tools and original software products for real-world problems." canonical="https://wearvalleydigital.com/"><section class="hero"><div class="wrap"><p class="eyebrow">Wear Valley Digital</p><h1>Practical digital tools for real-world problems</h1><p class="lede">Focused products, platforms and digital tools designed to make complex work clearer.</p><div class="button-row"><a class="button" href="/products/">Explore products</a><a class="text-link" href="/work/">See our product work <span aria-hidden="true">→</span></a></div></div></section><section class="section"><div class="wrap"><h2>Featured products</h2><div class="grid">{products.map(x=><article class="card"><p class="eyebrow">{x.product.category}</p><h3><a href={`/products/${x.product.category}/${x.product.slug}/`}>{x.product.name}</a></h3><p>{x.product.copy.short_description}</p></article>)}</div></div></section><section class="section"><div class="wrap"><h2>Selected product engineering</h2><p class="section-intro">Original software shaped around specialist problems, governed decisions and real-world use.</p><div class="grid"><article class="card work-card human-card"><p class="eyebrow">Connected training platform</p><h3><a href="/work/human-v1/">Human V1 — the athlete’s companion</a></h3><p>Responsive web authoring, native Android execution and governed cross-device delivery in one product ecosystem.</p></article><article class="card work-card pecp-card"><p class="eyebrow">Enterprise performance engineering</p><h3><a href="/work/performance-engineering-control-plane/">Performance Engineering Control Plane</a></h3><p>Turning fragmented requirements and business demand into defensible workload models, tests and engineering evidence.</p></article></div></div></section><section class="section"><div class="wrap"><h2>Browse by category</h2><div class="grid">{categories.map(x=><article class="card"><h3><a href={`/products/${x.slug}/`}>{x.name}</a></h3><p>{x.description}</p></article>)}</div></div></section></BaseLayout>
