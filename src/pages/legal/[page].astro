---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSite } from '../../lib/validation/load';
const site=loadSite();
export function getStaticPaths(){const pages={privacy:{title:'Privacy Policy',body:'This public site introduces Wear Valley Digital services and products. The fictional demos collect no personal details and create no bookings or enquiries. Optional site analytics are disabled unless you consent. Emailing a general enquiry shares the information you include with Wear Valley Digital so we can respond. Etsy privacy information applies when you visit or transact there.'},cookies:{title:'Cookie Policy',body:'This site stores your analytics-consent choice in your browser. Optional analytics are used only after consent. Etsy may apply its own cookies when you follow a link to its service.'},terms:{title:'Website Terms',body:'Wear Valley Digital provides information about its digital products. Product purchases, payment and delivery currently take place through Etsy. Bespoke website, software and automation work requires an agreed scope and separate project terms. This public site does not provide direct checkout, customer accounts or direct downloads. Nothing on this site is accounting, tax, legal or financial advice.'},'digital-product-terms':{title:'Digital Product Terms',body:'Digital products are purchased, paid for and delivered through Etsy. The applicable Etsy transaction terms and applicable consumer rights govern that purchase. Product files are supplied for the purchaser’s own use and may not be resold, redistributed or presented as another seller’s work.'},refunds:{title:'Refund Information',body:'Purchases are completed through Etsy rather than through a Wear Valley Digital checkout. Requests concerning an order, cancellation or refund should be made through the Etsy transaction environment and are governed by the applicable Etsy purchase terms together with applicable consumer rights.'},contact:{title:'Contact',body:'For website, software or automation enquiries, email hello@wearvalleydigital.com. This is a general enquiry address, not the monitored support channel. For Etsy product orders, use your Etsy order conversation.',link:true}} as const;return Object.entries(pages).map(([page,data])=>({params:{page},props:{data}}));} const {data}=Astro.props;
---
<BaseLayout title={`${data.title} | Wear Valley Digital`} description={`${data.title} for Wear Valley Digital.`} canonical={`https://wearvalleydigital.com/legal/${Astro.params.page}/`} index={false}><section class="hero"><div class="wrap"><p class="eyebrow">Legal</p><h1>{data.title}</h1><p class="lede">{data.body}</p>{Astro.params.page==='contact'&&<p><a href="mailto:hello@wearvalleydigital.com">Email a general enquiry</a></p>}{'link' in data&&<p><a href={site.customer_contact_url}>{site.customer_contact_label}</a></p>}</div></section></BaseLayout>
