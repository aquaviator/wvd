---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadSite } from '../../lib/validation/load';
const site=loadSite();
export function getStaticPaths(){const pages={privacy:{title:'Privacy Policy',body:'Wear Valley Digital does not provide customer accounts or direct checkout. Optional site analytics are disabled unless you consent. Purchases are completed on Etsy, whose privacy information applies when you visit or transact there.'},cookies:{title:'Cookie Policy',body:'This site stores your analytics-consent choice in your browser. Optional analytics are used only after consent. Etsy may apply its own cookies when you follow a link to its service.'},terms:{title:'Website Terms',body:'Wear Valley Digital provides information about its digital products. Product purchases, payment and delivery currently take place through Etsy. This website does not provide customer accounts, consulting, bespoke services or direct downloads. Nothing on this site is accounting, tax, legal or financial advice.'},'digital-product-terms':{title:'Digital Product Terms',body:'Digital products are purchased, paid for and delivered through Etsy. The applicable Etsy transaction terms and applicable consumer rights govern that purchase. Product files are supplied for the purchaser’s own use and may not be resold, redistributed or presented as another seller’s work.'},refunds:{title:'Refund Information',body:'Purchases are completed through Etsy rather than through a Wear Valley Digital checkout. Requests concerning an order, cancellation or refund should be made through the Etsy transaction environment and are governed by the applicable Etsy purchase terms together with applicable consumer rights.'},contact:{title:'Contact',body:'For a product or order enquiry, contact Wear Valley Digital through the configured sales channel or your order conversation. Wear Valley Digital does not currently operate a separate customer-account or direct-download service.',link:true}} as const;return Object.entries(pages).map(([page,data])=>({params:{page},props:{data}}));} const {data}=Astro.props;
---
<BaseLayout title={`${data.title} | Wear Valley Digital`} description={`${data.title} for Wear Valley Digital.`} canonical={`https://wearvalleydigital.com/legal/${Astro.params.page}/`} index={false}><section class="hero"><div class="wrap"><p class="eyebrow">Legal</p><h1>{data.title}</h1><p class="lede">{data.body}</p>{'link' in data&&<p><a href={site.customer_contact_url}>{site.customer_contact_label}</a></p>}</div></section></BaseLayout>
