---
import BaseLayout from '../../layouts/BaseLayout.astro';
export function getStaticPaths(){const pages={privacy:{title:'Privacy Policy',body:'This page describes how Wear Valley Digital handles personal information. Analytics are optional and consent-controlled. HUMAN LEGAL REVIEW REQUIRED before publication.'},cookies:{title:'Cookie Policy',body:'The site uses essential browser storage for analytics consent. Optional analytics must remain disabled until consent is granted. HUMAN LEGAL REVIEW REQUIRED before publication.'},terms:{title:'Terms',body:'These terms will govern use of this website. HUMAN LEGAL REVIEW REQUIRED: founder and legal adviser must supply and approve substantive terms.'},'digital-product-terms':{title:'Digital Product Terms',body:'HUMAN LEGAL REVIEW REQUIRED: supply licence scope, delivery terms, permitted use, and applicable consumer-rights wording.'},refunds:{title:'Refund Policy',body:'HUMAN LEGAL REVIEW REQUIRED: supply a policy consistent with the checkout provider and applicable consumer law.'},contact:{title:'Contact',body:'HUMAN REVIEW REQUIRED: add the approved customer contact channel before publication.'}} as const;return Object.entries(pages).map(([page,data])=>({params:{page},props:{data}}));} const {data}=Astro.props;
---
<BaseLayout title={`${data.title} | Wear Valley Digital`} description={`${data.title} for Wear Valley Digital.`} canonical={`https://wearvalleydigital.com/legal/${Astro.params.page}/`} index={false}><section class="hero"><div class="wrap"><p class="eyebrow">Legal</p><h1>{data.title}</h1><p class="lede">{data.body}</p></div></section></BaseLayout>
