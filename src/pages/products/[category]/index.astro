---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import {loadCategories,loadProducts} from '../../../lib/validation/load'; export function getStaticPaths(){return loadCategories().filter(c=>loadProducts().some(x=>x.product.category===c.slug&&x.product.status!=='draft')).map(category=>({params:{category:category.slug},props:{category}}));} const {category}=Astro.props; const products=loadProducts().filter(x=>x.product.category===category.slug&&x.product.status!=='draft');
---
<BaseLayout title={category.seo.title} description={category.seo.meta_description} canonical={`https://wearvalleydigital.com/products/${category.slug}/`}><section class="hero"><div class="wrap"><p class="eyebrow">Product category</p><h1>{category.name}</h1><p class="lede">{category.description}</p></div></section><section class="section"><div class="wrap grid">{products.map(x=><article class="card"><h2><a href={`/products/${x.product.category}/${x.product.slug}/`}>{x.product.name}</a></h2><p>{x.product.copy.short_description}</p></article>)}</div></section></BaseLayout>
