---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import ProductPage from '../../../components/product/ProductPage.astro'; import {loadProducts} from '../../../lib/validation/load'; import {isPubliclyIndexable} from '../../../lib/product/visibility'; export function getStaticPaths(){return loadProducts().filter(x=>x.product.status!=='draft').map(record=>({params:{category:record.product.category,slug:record.product.slug},props:{record}}));} const {record}=Astro.props; const related=loadProducts().filter(x=>x.product.category===record.product.category&&x.product.product_id!==record.product.product_id&&x.product.status==='active');
---
<BaseLayout title={record.seo.title} description={record.seo.meta_description} canonical={record.seo.canonical} index={isPubliclyIndexable(record.product)} image={record.seo.og_image}><ProductPage {record} {related}/></BaseLayout>
