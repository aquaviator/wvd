---
import PlatformCards from '../../components/PlatformCards.astro';
import BaseLayout from '../../layouts/BaseLayout.astro'; import {loadProducts} from '../../lib/validation/load'; const products=loadProducts().filter(x=>x.product.status!=='draft');
---
<BaseLayout title="Digital products | Wear Valley Digital" description="Browse practical digital products from Wear Valley Digital." canonical="https://wearvalleydigital.com/products/"><section class="hero"><div class="wrap"><p class="eyebrow">Product catalogue</p><h1>Salon and wedding websites, shaped around you</h1><p class="lede">Explore our two platforms in development: a configurable workspace for salon owners and a personalised website for couples.</p><p>Customer subscriptions and wedding hire are not open yet.</p></div></section><section class="section"><div class="wrap"><PlatformCards /></div></section><section class="section"><div class="wrap"><h2>Other digital tools</h2><p>Existing tools retain their individual availability status.</p><a class="text-link" href="/enquire/">Discuss what you need →</a></div></section><section class="section"><div class="wrap grid">{products.map(x=><article class="card"><p class="eyebrow">{x.product.category} · {x.product.status}</p><h2><a href={`/products/${x.product.category}/${x.product.slug}/`}>{x.product.name}</a></h2><p>{x.product.copy.short_description}</p></article>)}</div></section></BaseLayout>
