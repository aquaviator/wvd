---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {loadProducts} from '../../lib/validation/load'; const products=loadProducts().filter(x=>x.product.status==='active');
---
<BaseLayout title="Digital products | Wear Valley Digital" description="Browse practical digital products from Wear Valley Digital." canonical="https://wearvalleydigital.com/products/"><section class="hero"><div class="wrap"><p class="eyebrow">Product portfolio</p><h1>Useful tools, clearly explained</h1><p class="lede">Explore the WVD product portfolio. These products are in development; the links below lead to their engineering stories, not public application access or checkout.</p></div></section><section class="section"><div class="wrap"><h2>Products in development</h2><div class="grid"><article class="card human-card"><p class="eyebrow">In development · Connected training</p><h3>Human V1</h3><p>The athlete’s companion, bringing web authoring and native Android training into one product ecosystem.</p><a class="text-link" href="/work/human-v1/">Read the Human V1 build story</a></article><article class="card pecp-card"><p class="eyebrow">In development · Performance Engineering</p><h3>Performance Engineering Control Plane</h3><p>A governed software product being developed around specialist Performance Engineering knowledge.</p><a class="text-link" href="/work/performance-engineering-control-plane/">Read the PECP build story</a></article></div></div></section><section class="section"><div class="wrap grid">{products.map(x=><article class="card"><p class="eyebrow">{x.product.category} · {x.product.status}</p><h2><a href={`/products/${x.product.category}/${x.product.slug}/`}>{x.product.name}</a></h2><p>{x.product.copy.short_description}</p></article>)}</div></section></BaseLayout>
