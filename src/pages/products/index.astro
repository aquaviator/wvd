---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductShowcase from '../../components/ProductShowcase.astro';
import {loadProducts} from '../../lib/validation/load';
const products=loadProducts().filter(x=>x.product.status!=='draft');
---
<BaseLayout title="Our products | Wear Valley Digital" description="Explore Human V1, PECP, Salon Platform and Wedding Platform, with Hospitality coming soon." canonical="https://wearvalleydigital.com/products/">
<section class="showcase-intro"><div class="wrap"><p class="eyebrow">The WVD portfolio</p><h1>Products with a purpose.</h1><p class="lede">From the next training session to the next chapter in your business. Explore the products we’re building and their current availability.</p><nav class="showcase-links" aria-label="Product directory"><a href="#human-v1">Human V1</a><a href="#pecp">PECP</a><a href="#salon">Salon</a><a href="#wedding">Wedding</a><a href="#hospitality">Hospitality · Coming soon</a></nav></div></section>
<section class="showcase-section"><div class="wrap"><ProductShowcase /></div></section>
<section class="section"><div class="wrap"><h2>Other digital tools</h2><p>Existing tools retain their individual availability status.</p><div class="grid">{products.map(x=><article class="card"><p class="eyebrow">{x.product.category} · {x.product.status}</p><h3><a href={`/products/${x.product.category}/${x.product.slug}/`}>{x.product.name}</a></h3><p>{x.product.copy.short_description}</p></article>)}</div></div></section>
<section class="service-cta"><div class="wrap"><div class="showcase-callout"><div><h2>A product in mind—or an idea of your own?</h2><p>Talk to us about the right fit, current availability or a bespoke project.</p></div><a class="button" href="/enquire/">Discuss your needs</a></div></div></section>
</BaseLayout>
