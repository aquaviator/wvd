---
import '../styles/global.css';
const { title, description, canonical, index = true, image = '/images/landlord-ledger-og.svg' } = Astro.props;
---
<!doctype html>
<html lang="en-GB"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><title>{title}</title><meta name="description" content={description}><link rel="canonical" href={canonical}><meta name="robots" content={index?'index,follow':'noindex,follow'}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:image" content={new URL(image, Astro.site)}><meta property="og:type" content="website"></head>
<body><header class="site-header"><div class="wrap"><a class="brand" href="/">Wear Valley Digital</a></div></header><main><slot /></main><footer class="site-footer"><div class="wrap"><p><strong>Wear Valley Digital</strong> — practical digital tools for real-world problems.</p><nav aria-label="Legal"><a href="/products/">Products</a> · <a href="/legal/privacy/">Privacy</a> · <a href="/legal/cookies/">Cookies</a> · <a href="/legal/terms/">Terms</a> · <a href="/legal/contact/">Contact</a></nav><small>© {new Date().getFullYear()} Wear Valley Digital</small></div></footer><aside class="consent panel" id="consent" aria-label="Analytics consent" hidden><strong>Optional analytics</strong><p>Help us understand site use. Purchasing works either way.</p><button class="button" data-consent="granted">Allow</button> <button data-consent="declined">Decline</button></aside><script is:inline>const c=document.querySelector('#consent');if(!localStorage.getItem('wvd-analytics-consent'))c.hidden=false;document.querySelectorAll('[data-consent]').forEach(b=>b.addEventListener('click',()=>{localStorage.setItem('wvd-analytics-consent',b.dataset.consent);c.hidden=true;}));</script></body></html>
