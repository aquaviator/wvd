---
import '../styles/global.css';
import '../styles/case-study.css';
import { Image } from 'astro:assets';
import horizontalLogo from '../assets/brand/horizontal-logo.png';
const { title, description, canonical, index = true, image = '/favicon.svg', structuredData, disableAnalytics = false } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><title>{title}</title><meta name="description" content={description}><link rel="canonical" href={canonical}><meta name="robots" content={index?'index,follow':'noindex,follow'}><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:image" content={new URL(image, Astro.site)}><meta property="og:type" content="website">{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}</head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header"><div class="wrap header-inner"><a class="brand" href="/" aria-label="Wear Valley Digital home"><Image src={horizontalLogo} alt="Wear Valley Digital — Rural roots. Digital reach." width={260} format="webp" quality={85} /></a><nav class="site-nav" aria-label="Primary"><a href="/products/" aria-current={Astro.url.pathname.startsWith('/products/') ? 'page' : undefined}>Products</a><a href="/services/" aria-current={Astro.url.pathname.startsWith('/services/') ? 'page' : undefined}>Services</a><a href="/work/" aria-current={Astro.url.pathname.startsWith('/work/') ? 'page' : undefined}>Case studies</a><a href="/about/" aria-current={Astro.url.pathname.startsWith('/about/') ? 'page' : undefined}>About</a><a href="/insights/" aria-current={Astro.url.pathname.startsWith('/insights/') ? 'page' : undefined}>Guides</a><a href="/enquire/" aria-current={Astro.url.pathname.startsWith('/enquire/') ? 'page' : undefined}>Let’s talk ↗</a></nav></div></header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer"><div class="wrap"><div class="footer-topline"><p class="footer-statement">Rural roots.<br />Digital reach.</p><a class="text-link" href="/enquire/">Let’s talk about your next project ↗</a></div><p><strong>Wear Valley Digital</strong> · Websites, software and automation.</p><nav aria-label="Footer"><a href="/products/" aria-current={Astro.url.pathname.startsWith('/products/') ? 'page' : undefined}>Products</a><a href="/work/" aria-current={Astro.url.pathname.startsWith('/work/') ? 'page' : undefined}>Work</a><a href="/legal/privacy/">Privacy</a><a href="/legal/cookies/">Cookies</a><a href="/legal/terms/">Terms</a><a href="/legal/contact/">Contact</a></nav><small>© {new Date().getFullYear()} Wear Valley Digital</small></div></footer>
    {!disableAnalytics && <aside class="consent panel" id="consent" aria-label="Analytics consent" hidden><strong>Optional analytics</strong><p>Help us understand site use. You can browse our products either way.</p><button class="button" data-consent="granted">Allow</button> <button data-consent="declined">Decline</button></aside>}
    {!disableAnalytics && <script is:inline>const c=document.querySelector('#consent');if(!localStorage.getItem('wvd-analytics-consent'))c.hidden=false;document.querySelectorAll('[data-consent]').forEach(b=>b.addEventListener('click',()=>{localStorage.setItem('wvd-analytics-consent',b.dataset.consent);c.hidden=true;}));</script>}
  </body>
</html>
