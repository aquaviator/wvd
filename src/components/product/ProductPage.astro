---
import type { ProductRecord } from '../../lib/validation/load';
import { getCommerceProvider } from '../../lib/commerce';
import VideoFacade from './VideoFacade.astro';
import { isPubliclyIndexable } from '../../lib/product/visibility';
import '../../styles/media.css';
const { record, related = [] } = Astro.props as { record: ProductRecord; related: ProductRecord[] };
const { product, funnel, compliance, media } = record; const commerce = getCommerceProvider(funnel); const numericPrice=product.pricing.launch_price ?? product.pricing.standard_price; const price = new Intl.NumberFormat('en-GB',{style:'currency',currency:product.pricing.currency}).format(numericPrice); const available = isPubliclyIndexable(product) && commerce.isAvailable(); const productContext={product_id:product.product_id,product_slug:product.slug,category:product.category,funnel_version:funnel.funnel_version};
const videos=Object.values(media.video).map(video=>({'@type':'VideoObject',name:video.title,description:video.description,thumbnailUrl:new URL(video.poster,Astro.site).toString(),duration:`PT${video.duration.replace(':','M')}S`,contentUrl:new URL(video.source,Astro.site).toString()}));
const productJson={ '@context':'https://schema.org','@type':'Product',name:product.name,description:product.copy.short_description,category:product.category,url:record.seo.canonical,brand:{'@type':'Organization',name:'Wear Valley Digital'},subjectOf:videos,...(available?{offers:{'@type':'Offer',price:numericPrice.toFixed(2),priceCurrency:product.pricing.currency,availability:'https://schema.org/InStock',url:commerce.getCheckoutDestination()}}:{}) };
const crumbs={ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[['Products','/products/'],[product.category,`/products/${product.category}/`],[product.name,record.seo.canonical]].map(([name,item],i)=>({'@type':'ListItem',position:i+1,name,item:new URL(item,Astro.site).toString()}))};
---
<div class="wrap breadcrumbs" data-product-page data-product-id={product.product_id} data-product-slug={product.slug} data-category={product.category} data-funnel-version={funnel.funnel_version}><a href="/products/">Products</a> / <a href={`/products/${product.category}/`}>{product.category}</a> / <span>{product.name}</span></div>
<section class="hero"><div class="wrap hero-grid"><div><p class="eyebrow">Wear Valley Digital · {media.brand.category}</p><h1>{product.copy.headline}</h1><p class="lede">{product.copy.subheadline}</p>{product.status!=='active'&&<p class="status">This product is not currently available to purchase.</p>}<a id="hero-cta" class="button" href={available?commerce.getCheckoutDestination()??'#':'#'} aria-disabled={!available} data-commerce-cta data-product-id={product.product_id}>{available?`Buy externally — ${price}`:'Currently unavailable'}</a></div><img class="hero-media" src={media.hero.website.path} alt={media.hero.website.alt} width={media.hero.website.width} height={media.hero.website.height} fetchpriority="high" /></div></section>
<section class="section"><div class="wrap"><p class="eyebrow">Overview</p><h2>A closer look at {product.name}</h2><VideoFacade video={media.video.promo} eventPrefix="promo_video" {productContext} /></div></section>
<section class="section"><div class="wrap grid"><div><p class="eyebrow">The problem</p><h2>{product.customer.problem}</h2></div><div><p class="eyebrow">The outcome</p><h2>{product.customer.desired_outcome}</h2></div></div></section>
<section class="section"><div class="wrap"><p class="eyebrow">Product demonstration</p><h2>See {product.name} in use</h2><VideoFacade video={media.video.tutorial} eventPrefix="demo_video" {productContext} /></div></section>
{product.how_it_works?.length&&<section class="section"><div class="wrap"><h2>How it works</h2><ol class="grid">{product.how_it_works.map((step:string)=><li class="card">{step}</li>)}</ol></div></section>}
<section class="section"><div class="wrap"><h2>What’s included</h2><img class="feature-media" src={media.website.whats_included.path} alt={media.website.whats_included.alt} width={media.website.whats_included.width} height={media.website.whats_included.height} loading="lazy" decoding="async" /><div class="grid">{product.contents.included_files.map((item:string)=><div class="card">{item}</div>)}</div></div></section>
<section class="section"><div class="wrap"><h2>Product screenshots</h2><div class="media-grid">{media.screenshots.map(image=><figure class="card"><img src={image.path} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /><figcaption>{image.caption}</figcaption></figure>)}</div></div></section>
<section class="section"><div class="wrap grid"><div><h2>Benefits</h2><ul>{product.copy.benefits.map((x:string)=><li>{x}</li>)}</ul></div><div><h2>Compatibility</h2><ul>{product.contents.compatibility.map((x:string)=><li>{x}</li>)}</ul><h3>Requirements</h3><ul>{product.contents.requirements.map((x:string)=><li>{x}</li>)}</ul></div></div></section>
<section class="section"><div class="wrap media-grid"><img class="feature-media" src={media.website.compatibility.path} alt={media.website.compatibility.alt} width={media.website.compatibility.width} height={media.website.compatibility.height} loading="lazy" decoding="async" /><img class="feature-media" src={media.website.privacy.path} alt={media.website.privacy.alt} width={media.website.privacy.width} height={media.website.privacy.height} loading="lazy" decoding="async" /></div></section>
<section class="section"><div class="wrap panel"><h2>Product trust</h2><p>Version {product.trust.version} · Updated {product.trust.last_updated}</p><p>{product.trust.support_boundary}</p></div></section>
<section class="section"><div class="wrap"><h2>{available?'Ready to get started?':'Purchase unavailable'}</h2><p class="price">{price}</p><a class="button" href={available?commerce.getCheckoutDestination()??'#':'#'} aria-disabled={!available} data-commerce-cta>{available?'Continue to Etsy':'Currently unavailable'}</a>{available&&<p>Checkout takes place securely on Etsy.</p>}</div></section>
{product.faqs?.length&&<section class="section"><div class="wrap"><h2>Questions</h2>{product.faqs.map((faq:{question:string;answer:string})=><details class="panel"><summary><strong>{faq.question}</strong></summary><p>{faq.answer}</p></details>)}</div></section>}
<section class="section"><div class="wrap panel"><h2>Important information</h2><p>{product.disclosure}</p><p>{compliance.disclaimer}</p></div></section>
{related.length>0&&<section class="section"><div class="wrap"><h2>Related products</h2><div class="grid">{related.map(x=><article class="card"><a href={`/products/${x.product.category}/${x.product.slug}/`} data-related-product data-source-product-id={product.product_id} data-target-product-id={x.product.product_id} data-placement="product-page-related">{x.product.name}</a></article>)}</div></div></section>}
<div class="sticky-cta" data-available={String(available)}><span>{price}</span><a class="button" href={available?commerce.getCheckoutDestination()??'#':'#'} aria-disabled={!available} data-commerce-cta>{available?'Buy on Etsy':'Currently unavailable'}</a></div>
<script type="application/ld+json" set:html={JSON.stringify(productJson)} /><script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
<script>import {trackEvent} from '../../lib/analytics/client';const page=document.querySelector<HTMLElement>('[data-product-page]');const productContext={product_id:page?.dataset.productId,product_slug:page?.dataset.productSlug,category:page?.dataset.category,funnel_version:page?.dataset.funnelVersion};trackEvent('product_view',productContext);const hero=document.querySelector('#hero-cta');const sticky=document.querySelector('.sticky-cta');if(hero&&sticky)new IntersectionObserver(([entry])=>sticky.classList.toggle('visible',!entry.isIntersecting)).observe(hero);document.querySelectorAll('[data-commerce-cta]').forEach(el=>el.addEventListener('click',(event)=>{if(el.getAttribute('aria-disabled')==='true'){event.preventDefault();return;}trackEvent('cta_click',productContext);trackEvent('etsy_outbound',productContext);},{once:true}));document.querySelectorAll('[data-related-product]').forEach(el=>el.addEventListener('click',()=>trackEvent('related_product_click',{source_product_id:el.getAttribute('data-source-product-id')??undefined,target_product_id:el.getAttribute('data-target-product-id')??undefined,placement:el.getAttribute('data-placement')??undefined}),{once:true}));</script>
